# Fingerprint
CONFIG_FINGERPRINT_FPC_1540=m
CONFIG_FINGERPRINT_GOODIX_3626=m
CONFIG_INPUT_FINGERPRINT=y

# Power
CONFIG_BQ_FG_UPDATE=y
CONFIG_HAVE_CHARGE_TEMP=y

# MGLRU
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=y

# Energy Aware Scheduling (EAS) & Schedutil Tuning
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_SCHED_TOP_APP_NR_TRIGGERS=y
CONFIG_SCHED_TUNE=y
CONFIG_DEFAULT_SCHEDUTIL=y

# ZRAM ZSTD Configuration
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_CRYPTO_ZSTD=y

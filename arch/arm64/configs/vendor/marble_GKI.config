# Fingerprint
CONFIG_FINGERPRINT_FPC_1540=m
CONFIG_FINGERPRINT_GOODIX_3626=m
CONFIG_INPUT_FINGERPRINT=y

# Power
CONFIG_BQ_FG_UPDATE=y
CONFIG_HAVE_CHARGE_TEMP=y

# MGLRU
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=y

# SLUG debuging
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SLUB_DEBUG_ON is not set

# Kernel Tracing & Probing
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_GENERIC_TRACER is not set

# Debug Log & Stack Leak Checking
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_PANIC_ON_OOPS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set

# Audit Logging
# CONFIG_AUDIT is not set
# CONFIG_AUDITSYSCALL is not set

# Energy Aware Scheduling (EAS) & Schedutil Tuning
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_SCHED_TOP_APP_NR_TRIGGERS=y
CONFIG_SCHED_TUNE=y
CONFIG_DEFAULT_SCHEDUTIL=y
